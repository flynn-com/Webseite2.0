---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  bodyClass?: string;
  /** Vollständige URL zu einem OG-Bild (z. B. Cover-Foto des Projekts) */
  ogImage?: string;
  /** Seitentyp für Open Graph, default 'website' */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  lang: langProp,
  bodyClass,
  ogImage,
  ogType = 'website',
} = Astro.props;

const lang = langProp ?? getLangFromUrl(Astro.url);

const siteUrl = 'https://flynnbertsch.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const defaultOgImage = `${siteUrl}/og-default.jpg`;
const resolvedOgImage = ogImage ?? defaultOgImage;

// JSON-LD: Photographer + LocalBusiness (beide kombiniert)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Person', 'LocalBusiness'],
      '@id': `${siteUrl}/#person`,
      name: 'Flynn Bertsch',
      url: siteUrl,
      image: resolvedOgImage,
      description:
        lang === 'de'
          ? 'Professioneller Fotograf, Videograf, Webdesigner und Designer aus Stuttgart – tätig in Stuttgart, München und ganz Deutschland.'
          : 'Professional photographer, videographer, web designer and designer based in Stuttgart – working in Stuttgart, Munich and across Germany.',
      jobTitle: lang === 'de' ? 'Fotograf & Videograf' : 'Photographer & Videographer',
      knowsAbout:
        lang === 'de'
          ? ['Fotografie', 'Videografie', 'Webdesign', 'Design', 'Editorial', 'Kampagne', 'Portrait']
          : ['Photography', 'Videography', 'Web Design', 'Design', 'Editorial', 'Campaign', 'Portrait'],
      areaServed: [
        { '@type': 'City', name: 'Stuttgart' },
        { '@type': 'City', name: 'München' },
        { '@type': 'State', name: 'Baden-Württemberg' },
        { '@type': 'State', name: 'Bayern' },
        { '@type': 'Country', name: 'Deutschland' },
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Stuttgart',
        addressRegion: 'Baden-Württemberg',
        addressCountry: 'DE',
      },
      sameAs: [
        'https://www.instagram.com/flynnbertsch',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Flynn Bertsch Portfolio',
      publisher: { '@id': `${siteUrl}/#person` },
      inLanguage: lang === 'de' ? 'de-DE' : 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Primäre Meta-Tags -->
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content="Flynn Bertsch" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Flynn Bertsch Portfolio" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    {lang === 'de'
      ? <meta property="og:locale:alternate" content="en_US" />
      : <meta property="og:locale:alternate" content="de_DE" />
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
</body>
</html>

<script>
  // Zweizeilige Projekt-Titel (.pd2-title, .proj-card__title): erste Zeile bleibt in
  // normaler Größe, eine eventuelle zweite Zeile wird automatisch so weit verkleinert,
  // dass sie in einer Zeile Platz findet (statt umzubrechen/abgeschnitten zu werden).
  function fitTitle(el: HTMLElement) {
    const original = el.dataset.autofitOriginal ?? el.textContent?.trim() ?? '';
    el.dataset.autofitOriginal = original;
    el.textContent = original;

    const words = original.split(/\s+/).filter(Boolean);
    if (words.length < 2) return;

    const textNode = el.firstChild;
    if (!textNode || textNode.nodeType !== Node.TEXT_NODE) return;

    // Anhand der natürlichen Umbruchstelle (aktuelle Schriftgröße) herausfinden,
    // welche Wörter in Zeile 1 und welche in die restlichen Zeilen fallen.
    const range = document.createRange();
    let cursor = 0;
    const tops: number[] = [];
    for (const w of words) {
      const start = original.indexOf(w, cursor);
      const end = start + w.length;
      cursor = end;
      range.setStart(textNode, start);
      range.setEnd(textNode, end);
      tops.push(range.getBoundingClientRect().top);
    }

    const firstTop = tops[0];
    const line1: string[] = [];
    const rest: string[] = [];
    words.forEach((w, i) => (Math.abs(tops[i] - firstTop) < 2 ? line1 : rest).push(w));

    if (rest.length === 0) return; // passt bereits in eine Zeile

    const baseSize = parseFloat(getComputedStyle(el).fontSize);
    const minSize  = baseSize * 0.4;

    el.textContent = '';
    // Beide Zeilen als eigene Blockboxen (kein <br>, kein display:flex auf el selbst –
    // das würde die Breitenberechnung des äußeren Flex-Headers verfälschen).
    const line1El = document.createElement('span');
    line1El.style.display = 'block';
    line1El.textContent = line1.join(' ');
    el.appendChild(line1El);

    const restEl = document.createElement('span');
    // inline-block (nicht block!): muss auf seine natürliche Textbreite schrumpfen,
    // damit die Breitenmessung unten stimmt. Steht trotzdem automatisch in eigener
    // Zeile, weil davor ein Blockelement (line1El) steht.
    restEl.style.display    = 'inline-block';
    restEl.style.whiteSpace = 'nowrap';
    restEl.style.fontSize   = baseSize + 'px';
    restEl.textContent = rest.join(' ');
    el.appendChild(restEl);

    const availWidth = el.clientWidth;
    const restWidth   = restEl.getBoundingClientRect().width;
    if (availWidth > 0 && restWidth > availWidth) {
      const scaled = baseSize * (availWidth / restWidth);
      if (scaled < minSize) {
        // Auch bei minimaler Größe zu lang → normal umbrechen statt winzig quetschen
        restEl.style.whiteSpace = 'normal';
        restEl.style.fontSize   = minSize + 'px';
      } else {
        restEl.style.fontSize = scaled + 'px';
      }
    }

    // Zeilenabstand verkleinern: den von der Schriftgröße vorgegebenen natürlichen
    // Abstand messen und um die Hälfte reduzieren (nie negativ/überlappend).
    const naturalGap = restEl.getBoundingClientRect().top - line1El.getBoundingClientRect().bottom;
    if (naturalGap > 0) restEl.style.marginTop = `${-naturalGap * 0.5}px`;
  }

  function fitAllTitles() {
    document.querySelectorAll<HTMLElement>('.pd2-title, .proj-card__title').forEach(fitTitle);
  }

  fitAllTitles();
  document.fonts?.ready?.then(fitAllTitles);

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(fitAllTitles, 150);
  });
</script>
