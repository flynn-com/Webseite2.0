---
import { withBase } from '../i18n/ui';

interface Props {
  src: string;
  poster?: string;
}

const { src, poster } = Astro.props;
---

<video class="local-video" autoplay loop muted playsinline preload="auto" poster={poster ? withBase(poster) : undefined}>
  <source src={withBase(src)} />
</video>
