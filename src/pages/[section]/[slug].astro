---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import LocalVideo from '../../components/LocalVideo.astro';
import { t, pathForLang, projectDetailPath, withBase } from '../../i18n/ui';
import pageRoutes from '../../data/page-routes.json';

export async function getStaticPaths() {
  const entries = await getCollection('projects-de');
  return entries.map((entry) => ({
    params: { section: pageRoutes.de.projects, slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'projects-de'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const lang = 'de' as const;

const allProjects = await getCollection('projects-de')
  .then(list => list.sort((a, b) => a.data.order - b.data.order));
const totalProjects = allProjects.length;

const galleryImages = entry.data.gallery;
const videoLandscape = entry.data.videos;
const videoPortrait  = entry.data.videos_portrait;

// Video-Slot-Zuweisung ins Gallery-Grid (mehrere Videos pro Reihe möglich):
// Querformat (16:9):
//   videos[0] → Reihe 1 Links    (rowIdx 0, land2,     pos 0)
//   videos[1] → Reihe 3 Oben     (rowIdx 2, top1port2, pos 0 = volle Breite)
//   videos[2] → Reihe 4 Rechts   (rowIdx 3, land2,     pos 1)
// Hochformat (9:16):
//   videos_portrait[0] → Reihe 2 Rechts      (rowIdx 1, port3,     pos 'last')
//   videos_portrait[1] → Reihe 3 Unten Links (rowIdx 2, top1port2, pos 1)
//   videos_portrait[2+] → Reihe 5+ je 3 in port3-Reihen (rowIdx 4, 7, 10 …)
interface VideoAssignment { position: number | 'last' | 'full'; src: string; orientation: 'landscape' | 'portrait'; }
const videoAssignments = new Map<number, VideoAssignment[]>();
const addVid = (rowIdx: number, va: VideoAssignment) => {
  videoAssignments.set(rowIdx, [...(videoAssignments.get(rowIdx) ?? []), va]);
};
// Querformat
if (videoLandscape[0]) addVid(0, { position: 0,      src: videoLandscape[0], orientation: 'landscape' });
if (videoLandscape[1]) addVid(2, { position: 0,      src: videoLandscape[1], orientation: 'landscape' });
if (videoLandscape[2]) addVid(3, { position: 1,      src: videoLandscape[2], orientation: 'landscape' });
// Hochformat
if (videoPortrait[0])  addVid(1, { position: 'last', src: videoPortrait[0],  orientation: 'portrait'  });
if (videoPortrait[1])  addVid(2, { position: 1,      src: videoPortrait[1],  orientation: 'portrait'  });
for (let i = 0; i < videoPortrait.slice(2).length; i++) {
  addVid(4 + Math.floor(i / 3) * 3, { position: i % 3, src: videoPortrait[2 + i], orientation: 'portrait' });
}

type ImageSlot = { kind: 'image'; image: string; focal: string };
type VideoSlot = { kind: 'video'; src: string; orientation: 'landscape' | 'portrait'; full?: boolean };
type SlotItem  = ImageSlot | VideoSlot;
type GalleryRow = { type: 'land2' | 'port3' | 'land1' | 'top1port2'; slots: SlotItem[] };

const galleryRows: GalleryRow[] = [];
let imgCursor = 0;
let rowIndex = 0;
const maxVideoRow = videoAssignments.size ? Math.max(...videoAssignments.keys()) : -1;

const takeImgs = (n: number): ImageSlot[] => {
  const result = galleryImages.slice(imgCursor, imgCursor + n).map(g => ({
    kind: 'image' as const, image: g.image, focal: g.focal,
  }));
  imgCursor += result.length;
  return result;
};

while (imgCursor < galleryImages.length || rowIndex <= maxVideoRow) {
  const phase = rowIndex % 3;
  const rowVids = videoAssignments.get(rowIndex) ?? [];
  const totalSlots = phase === 0 ? 2 : 3;
  let rowType: GalleryRow['type'] = phase === 0 ? 'land2' : phase === 1 ? 'port3' : 'top1port2';
  let slots: SlotItem[] = [];

  const fullVid = rowVids.find(v => v.position === 'full');
  if (fullVid) {
    slots = [{ kind: 'video', src: fullVid.src, orientation: fullVid.orientation, full: true }];
  } else {
    // Baue numerische Positions-Map (position 'last' → totalSlots-1)
    const vidMap = new Map<number, VideoAssignment>();
    for (const v of rowVids) {
      const p = v.position === 'last' ? totalSlots - 1 : v.position as number;
      vidMap.set(p, v);
    }
    for (let i = 0; i < totalSlots; i++) {
      const v = vidMap.get(i);
      if (v) {
        slots.push({ kind: 'video', src: v.src, orientation: v.orientation });
      } else {
        const img = takeImgs(1);
        if (img.length > 0) slots.push(img[0]);
      }
    }
    // land2 mit nur 1 Bild (kein Video) → land1
    if (phase === 0 && slots.length === 1 && slots[0].kind === 'image') rowType = 'land1';
  }

  if (slots.length > 0) galleryRows.push({ type: rowType, slots });
  rowIndex++;
}

const otherProjects = allProjects.filter(p => p.data.slug !== entry.data.slug);

const hasBody = !!entry.body?.trim();
const hasDesc = !!entry.data.description?.trim();
// Fließtext (body) goes into the first port3 row's left slot if one exists and is not a video
const bodyGoesInGallery = hasBody && galleryRows.some(r => r.type === 'port3' && r.slots[0]?.kind === 'image');
let bodyPlaced = false;
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} – Flynn Bertsch | ${entry.data.location ? entry.data.location + ' · ' : ''}Fotograf & Videograf`}
  description={entry.data.description ?? `${entry.data.title} – ein Projekt von Flynn Bertsch, Fotograf und Videograf aus Stuttgart.`}
  ogImage={entry.data.cover ? `https://flynnbertsch.com${entry.data.cover}` : undefined}
  ogType="article"
>
<div class="pd2-page">

  <a class="pd2-nav" href={pathForLang(lang, 'projects')}>
    <span class="pd2-nav__icon">◄</span>
    <span>{t(lang, 'nav.projects')}</span>
  </a>
  <a class="am-contact-btn" href={pathForLang(lang, 'contact')}>{t(lang, 'nav.contact')}</a>

  <div class="pd2-header">
    <h1 class="pd2-title">{entry.data.title}</h1>
    <div class="pd2-header-right">
      <p class="pd2-counter">
        <span>{String(entry.data.order).padStart(2, '0')}/</span><span class="pd2-counter__total">{String(totalProjects).padStart(2, '0')}</span>
      </p>
      {entry.data.location && <p class="pd2-location">{entry.data.location}</p>}
    </div>
  </div>

  {/* Kurzbeschreibung immer oben; Fließtext als Fallback oben wenn kein port3-Slot */}
  {hasDesc && <div class="pd2-prose"><p>{entry.data.description}</p></div>}
  {hasBody && !bodyGoesInGallery && <div class="pd2-prose"><Content /></div>}

  {(entry.data.cover || entry.data.cover_video) && (
    <div class="pd2-hero">
      {entry.data.cover_video ? (
        <LocalVideo src={entry.data.cover_video} poster={entry.data.cover} />
      ) : (
        <button class="pd2-img pd2-hero__btn" type="button" data-src={withBase(entry.data.cover)} aria-label="Titelbild vergrößern">
          <img src={withBase(entry.data.cover)} alt={entry.data.title}
            style={`object-position:${entry.data.cover_focal}`}
            fetchpriority="high" decoding="async" />
        </button>
      )}
    </div>
  )}

  {galleryRows.length > 0 && (
    <div class="pd2-gallery">
      {galleryRows.map((row) => {
        const injectText = row.type === 'port3' && bodyGoesInGallery && !bodyPlaced && row.slots[0]?.kind === 'image';
        if (injectText) bodyPlaced = true;
        const slotsToRender = injectText ? row.slots.slice(1) : row.slots;
        return (
          <div class={`pd2-row pd2-row--${row.type}`}>
            {injectText && (
              <div class="pd2-text-slot"><Content /></div>
            )}
            {slotsToRender.map((slot) =>
              slot.kind === 'video' ? (
                <div class={`pd2-video-slot${slot.full ? ' pd2-video-slot--full' : ''}`}>
                  <LocalVideo src={slot.src} />
                </div>
              ) : (
                <button class="pd2-img" data-src={withBase(slot.image)} type="button">
                  <img src={withBase(slot.image)} alt="" loading="lazy"
                    style={`object-position:${slot.focal ?? '50% 50%'}`} />
                </button>
              )
            )}
          </div>
        );
      })}
    </div>
  )}

  {/* Übrig gebliebene Querformat-Videos ab dem 4. (Portrait alle im Grid) */}
  {videoLandscape.slice(3).length > 0 && (
    <div class="pd2-gallery">
      {videoLandscape.slice(3).map((src) => (
        <div class="pd2-video"><LocalVideo src={src} /></div>
      ))}
    </div>
  )}

  {entry.data.youtube.length > 0 && (
    <div class="pd2-gallery">
      {entry.data.youtube.map((url) => (
        <div class="pd2-video"><YouTubeEmbed url={url} lang={lang} /></div>
      ))}
    </div>
  )}

  {entry.data.bts_enabled && entry.data.bts_items.length > 0 && (
    <section class="pd2-bts-wrap">
      <img class="pd2-bts-wrap__logo" src={withBase('/uploads/hero/logo-flynn.png')} alt="" aria-hidden="true" />
      <div class="pd2-bts">
        <h2 class="pd2-bts__heading">Behind the Scenes</h2>
        <div class="pd2-bts__scroll-wrap">
          <div class="pd2-bts__track" id="btsTrack">
            {entry.data.bts_items.map((item) => {
              if (item.kind === 'image' && item.image) {
                return (
                  <div class="pd2-bts__item pd2-bts__item--media">
                    <img src={withBase(item.image)} alt="" loading="lazy" />
                  </div>
                );
              }
              if (item.kind === 'video' && item.video) {
                return (
                  <div class="pd2-bts__item pd2-bts__item--media">
                    <video src={withBase(item.video)} autoplay loop muted playsinline preload="metadata" />
                  </div>
                );
              }
              if (item.kind === 'text' && item.text) {
                return (
                  <div class="pd2-bts__item pd2-bts__item--text">
                    <p>{item.text}</p>
                  </div>
                );
              }
              return null;
            })}
          </div>
          <button class="pd2-bts__next" id="btsNext" type="button" aria-label="Weiter">&#8250;</button>
        </div>
      </div>
    </section>
  )}

  {otherProjects.length > 0 && (
    <section class="pd2-more">
      <h2 class="pd2-more__heading">Weitere Projekte</h2>
      <div class="pd2-more__scroll-wrap">
      <div class="pd2-more__grid" id="pd2MoreGrid">
        {otherProjects.map((p) => (
          <a class="pd2-more__card" href={projectDetailPath(lang, p.data.slug)}>
            <div class="pd2-more__img">
              {p.data.cover_video ? (
                <video
                  src={withBase(p.data.cover_video)}
                  poster={p.data.cover ? withBase(p.data.cover) : undefined}
                  style={`object-position: ${p.data.cover_focal ?? '50% 50%'}`}
                  autoplay loop muted playsinline preload="metadata"
                />
              ) : p.data.cover && (
                <img src={withBase(p.data.cover)} alt={p.data.title} loading="lazy"
                  style={`object-position: ${p.data.cover_focal ?? '50% 50%'}`} />
              )}
              <div class="pd2-more__overlay">
                <span class="pd2-more__num">{String(p.data.order).padStart(2, '0')}/{String(totalProjects).padStart(2, '0')}</span>
                <span class="pd2-more__title">{p.data.title}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
      </div>
    </section>
  )}

</div>

<div class="pd2-lightbox" id="pdLightbox" aria-hidden="true">
  <button class="pd2-lightbox__close" id="pdLightboxClose" aria-label="Schließen">✕</button>
  <button class="pd2-lightbox__nav pd2-lightbox__prev" id="pdLightboxPrev" aria-label="Vorheriges Bild">&#10094;</button>
  <button class="pd2-lightbox__nav pd2-lightbox__next" id="pdLightboxNext" aria-label="Nächstes Bild">&#10095;</button>
  <img class="pd2-lightbox__img" id="pdLightboxImg" src="" alt="" />
</div>
</BaseLayout>

<script>
  const lightbox = document.getElementById('pdLightbox') as HTMLElement;
  const lbImg    = document.getElementById('pdLightboxImg') as HTMLImageElement;
  const lbClose  = document.getElementById('pdLightboxClose') as HTMLButtonElement;
  const lbPrev   = document.getElementById('pdLightboxPrev') as HTMLButtonElement;
  const lbNext   = document.getElementById('pdLightboxNext') as HTMLButtonElement;

  // Alle anklickbaren Bilder in DOM-Reihenfolge (Hero zuerst, dann Galerie)
  const imgBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('button.pd2-img[data-src]'));
  let currentIdx = 0;

  function openLightbox(idx: number) {
    currentIdx = idx;
    lbImg.src = imgBtns[idx]?.dataset.src ?? '';
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.classList.add('is-open');
    // Pfeile nur zeigen wenn mehr als 1 Bild
    const showNav = imgBtns.length > 1;
    lbPrev.style.display = showNav ? '' : 'none';
    lbNext.style.display = showNav ? '' : 'none';
  }

  function closeLightbox() {
    lightbox.setAttribute('aria-hidden', 'true');
    lightbox.classList.remove('is-open');
  }

  function showPrev() {
    currentIdx = (currentIdx - 1 + imgBtns.length) % imgBtns.length;
    lbImg.src = imgBtns[currentIdx]?.dataset.src ?? '';
  }

  function showNext() {
    currentIdx = (currentIdx + 1) % imgBtns.length;
    lbImg.src = imgBtns[currentIdx]?.dataset.src ?? '';
  }

  imgBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => openLightbox(i));
  });

  lbPrev.addEventListener('click', (e) => { e.stopPropagation(); showPrev(); });
  lbNext.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });
  lbClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'ArrowLeft')  showPrev();
    if (e.key === 'ArrowRight') showNext();
    if (e.key === 'Escape')     closeLightbox();
  });

  // ── Behind the Scenes: horizontales Ziehen + Weiter-Pfeil ──
  const btsTrack = document.getElementById('btsTrack');
  const btsNext  = document.getElementById('btsNext') as HTMLButtonElement | null;
  if (btsTrack) {
    btsNext?.addEventListener('click', () => {
      btsTrack.scrollBy({ left: btsTrack.clientWidth * 0.7, behavior: 'smooth' });
    });

    function updateBtsNextVisibility() {
      const maxScroll = btsTrack!.scrollWidth - btsTrack!.clientWidth - 4;
      if (btsNext) btsNext.style.display = btsTrack!.scrollLeft >= maxScroll ? 'none' : '';
    }
    btsTrack.addEventListener('scroll', updateBtsNextVisibility, { passive: true });
    updateBtsNextVisibility();

    // Maus-Ziehen (Desktop) — Touch/Trackpad nutzen bereits natives Scrollen
    let isDragging = false, dragStartX = 0, dragStartScroll = 0;
    btsTrack.addEventListener('mousedown', (e) => {
      isDragging = true;
      dragStartX = e.pageX;
      dragStartScroll = btsTrack.scrollLeft;
      btsTrack.classList.add('is-dragging');
    });
    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      btsTrack.scrollLeft = dragStartScroll - (e.pageX - dragStartX);
    });
    window.addEventListener('mouseup', () => {
      isDragging = false;
      btsTrack.classList.remove('is-dragging');
    });
  }


</script>
