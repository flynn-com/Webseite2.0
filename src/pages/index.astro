---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Hero from '../components/Hero.astro';
import { t, pathForLang } from '../i18n/ui';

const lang = 'de' as const;
const allProjects = await getCollection('projects-de');
const projectsToShow = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<BaseLayout
  lang={lang}
  title="Flynn Bertsch \u2013 Fotograf & Videograf | Stuttgart & M\u00fcnchen"
  description="Flynn Bertsch \u2013 professioneller Fotograf und Videograf aus Stuttgart. Editorials, Kampagnen, Portraits und Webdesign. T\u00e4tig in Stuttgart, M\u00fcnchen und ganz Deutschland."
  bodyClass="has-hero"
>
  <Hero lang={lang} />

  <section class="portfolio-heading">
    <h1>{t(lang, 'home.portfolio')}</h1>
  </section>

  <section class="projects-section">
    {projectsToShow.length === 0 ? (
      <p style="color:#fff;">{t(lang, 'projects.empty')}</p>
    ) : (
      <div class="project-grid">
        {projectsToShow.map((p, i) => (
          <ProjectCard
            lang={lang}
            slug={p.data.slug}
            title={p.data.title}
            category={p.data.category}
            cover={p.data.cover}
            cover_focal={p.data.cover_focal}
            cover_video={p.data.cover_video}
            description={p.data.description}
            location={p.data.location}
            gallery={p.data.gallery}
            date={p.data.date}
            index={i}
            total={projectsToShow.length}
          />
        ))}
      </div>
    )}

    <p style="margin-top: 2rem; text-align: center;">
      <a class="pd2-nav" href={pathForLang(lang, 'projects')}>
        <span>{t(lang, 'home.cta.allProjects')}</span>
        <span class="pd2-nav__icon">►</span>
      </a>
    </p>
  </section>
</BaseLayout>
